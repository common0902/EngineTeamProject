--- !u!114 &2035943386
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2035943382}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a80e7db85ee56fb4caf53a8701baae32, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _textUI: {fileID: 1561603220}
  _dialogues:
  - "\uC5B4\uB290 \uB0A0, \uC9C0\uD558\uB3C4\uC2DC \uB8E8\uBBF8\uB108\uB9AC \uD544\uB4DC
    \uCD5C\uC2EC\uBD80\uC5D0 \uC788\uB294 \"\uC601\uC6D0\uD788 \uAEBC\uC9C0\uC9C0
    \uC54A\uB294 \uBD88\uAF43\"\uC774 \uAEBC\uC838\uBC84\uB9AC\uB294 \uC0AC\uACE0\uAC00
    \uBC1C\uC0DD\uD558\uC600\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB85C \uC778\uD574\uC11C \uC804 \uC138\uACC4\uC758 \uB3C4\uC2DC \uC804\uCCB4\uB97C
    \uAC10\uC2F8\uB358 \uBE5B\uC774 \uC0AC\uB77C\uC9C0\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC5B4\uB460\uC5D0\uC11C \uAE30\uC778\uD55C \uBAAC\uC2A4\uD130\uB4E4\uC758 \uC2B5\uACA9\uC73C\uB85C
    \uC778\uB958\uB294 \uBA78\uB9DD\uC758 \uC704\uAE30\uC5D0 \uB193\uC774\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC790\uC9C4\uD558\uBA70 \uC601\uC6D0\uD788
    \uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uBD88\uAF43\uC744 \uB2E4\uC2DC \uC9C0\uD53C\uB7EC
    \uB8E8\uBBF8\uB108\uB9AC \uD544\uB4DC\uB85C \uD5A5\uD558\uC600\uC9C0\uB9CC...\n                                 
    \n\uBAA8\uB450 \uC18C\uC2DD\uC774 \uB04A\uACBC\uC2B5\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC740 \uC774 \uC138\uC0C1\uC5D0\uC11C \"\uC601\uC6D0\uD788 \uAEBC\uC9C0\uC9C0
    \uC54A\uB294 \uBD88\uAF43\"\uC758 \uBD88\uC744 \uB2E4\uC2DC \uC9C0\uD544 \uC218
    \uC788\uB294 \uBD88\uC528,\n\"\uB9C8\uC9C0\uB9C9 \uBD88\uC528\"\uB97C \uAC00\uC9C4
    \uC720\uC77C\uD55C \uBD88 \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4. "
  - "\uB2F9\uC2E0\uC740 \uC790\uC9C4\uD574\uC11C \uC138\uACC4\uB97C \uAD6C\uD558\uAE30
    \uC704\uD574 \uC9C0\uAE08, \uB8E8\uBBF8\uB108\uB9AC \uD544\uB4DC\uC758 \uC785\uAD6C
    \uC55E\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC758 \uC784\uBB34\uB294 \uC774\uB7F0 \uC704\uAE30\uB85C\uBD80\uD130
    \uC138\uC0C1\uC744 \uAD6C\uD558\uAE30 \uC704\uD574\n\uB9C8\uC9C0\uB9C9 \uBD88\uC528\uB97C
    \uAC00\uC9C0\uACE0 \uB358\uC804\uC774 \uB41C \uC9C0\uD558\uB3C4\uC2DC\uC758 \uC785\uAD6C\uC5D0\uC11C\uBD80\uD130
    \uCD5C\uC2EC\uBD80\uB85C \uB0B4\uB824\uAC00\n\n\"\uC601\uC6D0\uD788 \uAEBC\uC9C0\uC9C0
    \uC54A\uB294 \uBD88\uAF43\"\uC744 \uB2E4\uC2DC \uC9C0\uD53C\uB294 \uAC83\uC785\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC758 \uBD88\uAF43\uC73C\uB85C, \uC774 \uB358\uC804\uACFC \uC138\uACC4\uB97C
    \uAD6C\uD574\uC8FC\uC138\uC694."
  _typingSpeed: 0.08
  _delayBetweenLines: 1.5
